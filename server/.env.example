# Application
NODE_ENV=development
PORT=5000
APP_NAME=JobPortal
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# MongoDB
#MONGO_URI=mongodb+srv://Shobana11:Kamaraj@11@cluster0.w04wu4m.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb+srv://Shobana11:Kamaraj%4011@cluster0.w04wu4m.mongodb.net/jobportal?retryWrites=true&w=majority&appName=Cluster0

# Authentication
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Reset
PASSWORD_RESET_EXPIRES_MINUTES=30

# Encryption
ENCRYPTION_KEY=CHANGE_ME

# Cookies
# Leave empty on localhost. Set only for a real domain, e.g. .myjobs.com
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Job Portal

# File Storage
STORAGE_DRIVER=local

# Local storage
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=30

# Logging
LOG_LEVEL=info
